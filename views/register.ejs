<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Registro</title>
  <link rel="stylesheet" href="/css/main2.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

  <!-- Navbar -->
  <nav class="bg-green-600">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <a class="text-white text-lg font-semibold" href="#">Riego Inteligente</a>
      <div class="flex space-x-2">
        <a href="/" class="px-3 py-2 text-white border border-white rounded hover:bg-white hover:text-green-600 transition">Inicio</a>
        <a href="/historial" class="px-3 py-2 text-white border border-white rounded hover:bg-white hover:text-green-600 transition">Historial</a>
        <a href="/register" class="px-3 py-2 text-white border border-white rounded hover:bg-white hover:text-green-600 transition">Registrar Usuario</a>
        <% if (correo) { %>
          <span class="text-white mr-3"><%= correo %></span>
        <% } %>
        <a href="/logout" class="px-3 py-2 text-white border border-white rounded hover:bg-white hover:text-green-600 transition">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <!-- Formulario -->
  <div class="max-w-md mx-auto mt-10">
    <div class="bg-white shadow-lg rounded-xl p-6">
      <h2 class="text-2xl font-bold text-center mb-4">Crear cuenta</h2>

      <div id="alerta" class="hidden p-3 mb-4 rounded" role="alert"></div>

      <form id="registerForm" class="space-y-4">
        <div>
          <label for="nombre" class="block text-sm font-medium">Nombre</label>
          <input type="text" id="nombre" name="nombre" required class="w-full border-gray-300 rounded px-3 py-2 mt-1 focus:outline-none focus:ring-2 focus:ring-green-500" />
        </div>

        <div>
          <label for="apellido" class="block text-sm font-medium">Apellido</label>
          <input type="text" id="apellido" name="apellido" required class="w-full border-gray-300 rounded px-3 py-2 mt-1 focus:outline-none focus:ring-2 focus:ring-green-500" />
        </div>

        <div>
          <label for="correo" class="block text-sm font-medium">Correo electrónico</label>
          <input type="email" id="correoInput" name="correo" required class="w-full border-gray-300 rounded px-3 py-2 mt-1 focus:outline-none focus:ring-2 focus:ring-green-500" />
        </div>

        <div>
          <label for="username" class="block text-sm font-medium">Usuario</label>
          <input type="text" id="username" name="username" required class="w-full border-gray-300 rounded px-3 py-2 mt-1 focus:outline-none focus:ring-2 focus:ring-green-500" />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium">Contraseña</label>
          <input type="password" id="password" name="password" required class="w-full border-gray-300 rounded px-3 py-2 mt-1 focus:outline-none focus:ring-2 focus:ring-green-500" />
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium">Confirmar contraseña</label>
          <input type="password" id="confirmPassword" required class="w-full border-gray-300 rounded px-3 py-2 mt-1 focus:outline-none focus:ring-2 focus:ring-green-500" />
          <p class="text-red-500 text-sm mt-1 hidden" id="passwordMismatch">Las contraseñas no coinciden</p>
        </div>

        <button type="submit" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">Registrarse</button>
      </form>
    </div>
  </div>

  <script>
    document.getElementById("registerForm").addEventListener("submit", async function (e) {
      e.preventDefault();

      const pass = document.getElementById("password");
      const confirmPass = document.getElementById("confirmPassword");
      const alerta = document.getElementById("alerta");
      const passwordMismatch = document.getElementById("passwordMismatch");

      if (pass.value !== confirmPass.value) {
        passwordMismatch.classList.remove("hidden");
        return;
      } else {
        passwordMismatch.classList.add("hidden");
      }

      const data = {
        nombre: document.getElementById("nombre").value,
        apellido: document.getElementById("apellido").value,
        correo: document.getElementById("correoInput").value,
        username: document.getElementById("username").value,
        password: pass.value
      };

      try {
        const response = await fetch("/register", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        alerta.classList.remove("hidden");
        alerta.classList.add(response.ok ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700");
        alerta.textContent = response.ok ? result.message : (result.error || "Error desconocido");

        if (response.ok) {
          document.getElementById("registerForm").reset();
        }

      } catch (error) {
        alerta.classList.remove("hidden");
        alerta.classList.add("bg-red-100", "text-red-700");
        alerta.textContent = "Error al registrar usuario.";
        console.error(error);
      }
    });
  </script>

</body>
</html>
