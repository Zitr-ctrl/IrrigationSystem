<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Estado del Sistema de Riego</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .maceta-card:hover {
      transform: scale(1.02);
    }
    .emoji {
      font-size: 2rem;
    }
    .modal-enter {
      opacity: 0;
      transform: scale(0.95);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .modal-enter-active {
      opacity: 1;
      transform: scale(1);
    }
    .modal-leave {
      opacity: 1;
      transform: scale(1);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .modal-leave-active {
      opacity: 0;
      transform: scale(0.95);
    }
  </style>
</head>
<body class="bg-gray-100">

  <!-- Navbar -->
  <nav class="bg-green-600 text-white">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <a class="text-lg font-semibold" href="#">Riego Inteligente</a>
      <div class="flex flex-wrap gap-2">
        <a href="/" class="px-3 py-2 border border-white rounded hover:bg-white hover:text-green-600 transition">Inicio</a>
        <a href="/historial" class="px-3 py-2 border border-white rounded hover:bg-white hover:text-green-600 transition">Historial</a>
        <% if (user.tipo_user_id === 1) { %>
          <a href="/register" class="px-3 py-2 border border-white rounded hover:bg-white hover:text-green-600 transition">Registrar Usuario</a>
        <% } %>
        <span class="mr-3"><%= correo %></span>
        <a href="/logout" class="px-3 py-2 border border-white rounded hover:bg-white hover:text-green-600 transition">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto py-10 px-4">
    <h2 class="text-center text-2xl font-bold mb-6">🌱 Estado Actual del Sistema de Riego</h2>

    <!-- Estado de la bomba -->
    <div class="text-center py-3 rounded mb-6 <%= bombaEncendida ? 'bg-green-100 text-green-800' : 'bg-gray-200 text-gray-700' %>">
      <span class="emoji"><%= bombaEncendida ? '💦' : '🛑' %></span>
      <strong>Bomba:</strong> <%= bombaEncendida ? 'Encendida' : 'Apagada' %>
    </div>

    <!-- Tarjetas de macetas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% macetas.forEach((maceta) => { %>
        <div class="bg-white rounded-xl shadow-md p-4 transform transition duration-300 maceta-card">
          <div class="text-center">
            <h5 class="text-lg font-semibold mb-2">🪴 <%= maceta.nombre %></h5>
            <p class="text-gray-700">
              Planta: <strong><%= maceta.planta %></strong><br/>
              Tamaño: <strong><%= maceta.tamaño %></strong><br/>
              Humedad actual: <strong><%= maceta.humedad %>%</strong><br/>
              Humedad mínima: <strong><%= maceta.humedad_minima %>%</strong><br/>
              <span class="emoji">
                <%= maceta.humedad >= 70 ? '💧' : (maceta.humedad >= 40 ? '🌿' : '🥀') %>
              </span>
            </p>
            <small class="text-gray-500 block mt-2">Actualizado: <%= maceta.fecha %></small>
          </div>
          <% if (user.tipo_user_id === 1) { %>
            <div class="flex justify-center gap-2 mt-4">
              <button 
                class="px-3 py-1 bg-yellow-400 text-black rounded hover:bg-yellow-500 transition"
                onclick="openModal('setHumedadModal', <%= maceta.id %>, '<%= maceta.nombre %>')">
                Establecer humedad mínima
              </button>
              <button 
                class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 transition"
                onclick="openEditModal(<%= maceta.id %>, '<%= maceta.nombre %>', '<%= maceta.planta %>', '<%= maceta.tamaño %>')">
                Editar información
              </button>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Modales -->
  <% if (user.tipo_user_id === 1) { %>
    <!-- Modal Humedad Mínima -->
    <div id="setHumedadModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-6 w-full max-w-md">
        <h5 class="text-lg font-semibold mb-4">Establecer nivel de humedad mínima</h5>
        <form id="humedadForm" class="space-y-4">
          <input type="hidden" id="macetaIdSeleccionada">
          <div>
            <label for="macetaZona" class="block text-sm font-medium">Maceta</label>
            <input type="text" id="macetaZona" class="w-full border rounded px-3 py-2 bg-gray-100" disabled />
          </div>
          <div>
            <label for="humedad" class="block text-sm font-medium">Nivel (%)</label>
            <input type="number" id="humedad" min="0" max="100" required class="w-full border rounded px-3 py-2" />
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" class="px-3 py-1 bg-gray-300 rounded" onclick="closeModal('setHumedadModal')">Cancelar</button>
            <button type="submit" class="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700">Guardar</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal Editar Información -->
    <div id="editMacetaModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-6 w-full max-w-md">
        <h5 class="text-lg font-semibold mb-4">Editar información de la maceta</h5>
        <form id="editMacetaForm" class="space-y-4">
          <input type="hidden" id="macetaIdEditar" />
          <div>
            <label class="block text-sm font-medium">Nombre de la maceta</label>
            <input type="text" id="macetaNombre" required class="w-full border rounded px-3 py-2" />
          </div>
          <div>
            <label class="block text-sm font-medium">Nombre de la planta</label>
            <input type="text" id="macetaPlanta" required class="w-full border rounded px-3 py-2" />
          </div>
          <div>
            <label class="block text-sm font-medium">Tamaño de la maceta</label>
            <input type="text" id="macetaTamaño" required class="w-full border rounded px-3 py-2" />
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" class="px-3 py-1 bg-gray-300 rounded" onclick="closeModal('editMacetaModal')">Cancelar</button>
            <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700">Guardar cambios</button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <!-- Scripts -->
  <script>
    setInterval(() => location.reload(), 10000);

    function openModal(id, macetaId, macetaZona) {
      const modal = document.getElementById(id);
      modal.classList.remove('hidden');
      modal.classList.add('modal-enter', 'modal-enter-active');
      if (macetaId && macetaZona) {
        document.getElementById('macetaIdSeleccionada').value = macetaId;
        document.getElementById('macetaZona').value = macetaZona;
      }
    }

    function openEditModal(id, nombre, planta, tamaño) {
      const modal = document.getElementById('editMacetaModal');
      modal.classList.remove('hidden');
      modal.classList.add('modal-enter', 'modal-enter-active');
      document.getElementById('macetaIdEditar').value = id;
      document.getElementById('macetaNombre').value = nombre;
      document.getElementById('macetaPlanta').value = planta;
      document.getElementById('macetaTamaño').value = tamaño;
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      modal.classList.add('modal-leave', 'modal-leave-active');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('modal-leave', 'modal-leave-active');
      }, 200);
    }
  </script>
</body>
</html>
